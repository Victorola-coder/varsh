// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Donation {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("NGN")
  name        String?
  email       String
  anonymous   Boolean  @default(false)
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CampusClub {
  id          String   @id @default(cuid())
  name        String
  university  String
  description String?
  logo        String?
  members     Int      @default(0)
  // Public-facing / coordinator fields
  location    String?
  clubName    String?
  imageUrl    String?
  coordinator String?
  phone       String?
  email       String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Editable website content
// ---------------------------------------------------------------------------

/// Key/value store for "singleton" sections of the site (hero, about story,
/// newsletter copy, the "More" band, etc.). `value` holds an arbitrary JSON
/// shape per key so each section can evolve without a migration.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// Featured Initiatives cards on the homepage.
model Initiative {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  image       String
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// "Our Thematic Areas" cards.
model ThematicArea {
  id        String   @id @default(cuid())
  title     String
  content   String
  icon      String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// "Our Reach" impact statistics.
model ReachStat {
  id          String   @id @default(cuid())
  number      String
  label       String
  description String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// Bullet points in the VARSH Foundation "strides" list.
model Stride {
  id        String   @id @default(cuid())
  label     String
  text      String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Team members for the About page.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Projects / programmes.
model Project {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  summary   String?
  content   String?
  image     String?
  date      DateTime?
  order     Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Frequently asked questions.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}
